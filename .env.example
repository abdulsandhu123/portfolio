# MongoDB Atlas connection string (Database Access user + IP access 0.0.0.0/0 for Vercel)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Optional: database name (defaults to "portfolio")
MONGODB_DB=portfolio

# Password used to unlock the admin panel on the site
ADMIN_SECRET=choose-a-strong-password
